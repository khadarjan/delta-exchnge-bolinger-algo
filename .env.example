# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git or share it.

DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Production-India (default) or Production-Global
DELTA_BASE_URL=https://api.india.delta.exchange

# Comma-separated. Confirm exact symbol strings in-app first (Derivatives ->
# search "Gold"/"Ethereum") — XAUUSD is the commonly used gold symbol on
# Delta India but verify before going live.
SYMBOLS=ETHUSD,XAUUSD

# Per-symbol contract size (falls back to ORDER_SIZE if not set individually)
ORDER_SIZE=1
ORDER_SIZE_ETHUSD=1
ORDER_SIZE_XAUUSD=1

LEVERAGE=5
